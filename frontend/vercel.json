{
  "redirects": [
    {
      "source": "/:page(login|register|dashboard|streaks|messages|trust|profile|family|family-home|game|emergency-contacts)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(iphone|ipod|android.*mobile).*"
        }
      ],
      "missing": [{ "type": "cookie", "key": "towinly_web" }],
      "destination": "/app/:page",
      "permanent": false
    },
    {
      "source": "/:page(messages|user)/:id([^/.]+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(iphone|ipod|android.*mobile).*"
        }
      ],
      "missing": [{ "type": "cookie", "key": "towinly_web" }],
      "destination": "/app/:page/:id",
      "permanent": false
    },
    {
      "source": "/profile/change-password",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(iphone|ipod|android.*mobile).*"
        }
      ],
      "missing": [{ "type": "cookie", "key": "towinly_web" }],
      "destination": "/app/profile/change-password",
      "permanent": false
    },
    {
      "source": "/family-home/parent/:elderId([^/.]+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(iphone|ipod|android.*mobile).*"
        }
      ],
      "missing": [{ "type": "cookie", "key": "towinly_web" }],
      "destination": "/app/family-home/parent/:elderId",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/app", "destination": "https://towinly-app.vercel.app/" },
    { "source": "/app/:path*", "destination": "https://towinly-app.vercel.app/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-PZOpAWL/MJJAYBDYywQUagkVP5hAz71KmoGgBEG2oqg=' https://*.posthog.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' https://*.amazonaws.com data: blob:; connect-src 'self' https://backend-production-cef3.up.railway.app https://accounts.google.com https://*.amazonaws.com https://*.posthog.com; worker-src 'self' blob:; frame-ancestors 'none'"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" }
      ]
    },
    {
      "source": "/app/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
