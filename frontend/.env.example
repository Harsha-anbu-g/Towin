VITE_API_BASE_URL=http://localhost:8080/api

# PostHog product analytics (public, write-only project key — safe to ship in the client)
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Where a person writes about the Terms of Service and the Privacy Policy — and the
# only route to a copy of their data or to having their account deleted. Leave it
# blank and both pages say plainly that no address is set yet. Never put an address
# here that cannot receive mail: it looks real, so the letter goes, and nothing comes back.
VITE_LEGAL_CONTACT_EMAIL=
