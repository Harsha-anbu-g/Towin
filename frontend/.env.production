# Production API base URL — baked into the Vercel build by `vite build`.
# Without this, the build falls back to http://localhost:8080/api and the live
# site (incl. "Sign in with Google") points at localhost instead of Railway.
VITE_API_BASE_URL=https://backend-production-cef3.up.railway.app/api

# Where a person writes about the Terms of Service and the Privacy Policy.
# It is the ONLY route to a copy of your data or to having your account deleted
# — the endpoints exist on the server but no screen calls them — so it must be a
# mailbox that really answers. Leave it out and both pages say plainly that no
# address is set yet, which is the honest state; never put a plausible-looking
# address here that cannot receive mail.
# A personal mailbox is a poor choice long term (see docs/operations/sealed-box-release.md,
# which flags the same thing for the Sealed box release address). Moving off it is a
# change to this line, not to any code.
VITE_LEGAL_CONTACT_EMAIL=agharsha.anbu@gmail.com
